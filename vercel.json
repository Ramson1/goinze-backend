{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && nest build",
  "outputDirectory": "dist",
  "functions": {
    "dist/vercel.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/dist/vercel.js" }
  ]
}
