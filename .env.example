# ============================================================
# Goinzeschool API — Environment Variables (example)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- Database (Neon PostgreSQL) ----
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/goinzeschool?sslmode=require"
# Direct connection used by Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/goinzeschool?sslmode=require"

# ---- Auth / JWT ----
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- App ----
NODE_ENV="development"
API_PORT="4000"

# ---- Cloudinary (images / documents) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Flutterwave (payments — primary account) ----
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# ---- Flutterwave (payments — secondary account for Portal Access Fee) ----
FLUTTERWAVE_PORTAL_ACCESS_PUBLIC_KEY=""
FLUTTERWAVE_PORTAL_ACCESS_SECRET_KEY=""

# ---- Paystack (payments — primary account) ----
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# ---- Paystack (payments — secondary account for Portal Access Fee) ----
PAYSTACK_PORTAL_ACCESS_PUBLIC_KEY=""
PAYSTACK_PORTAL_ACCESS_SECRET_KEY=""

# ---- Redis (cache + BullMQ queues) ----
REDIS_URL="redis://localhost:6379"

# ---- SMTP (contact form emails) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Goinze International School"
SMTP_FROM_EMAIL=""
CONTACT_RECIPIENT_EMAIL=""

# ---- Resend (transactional emails) ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"
# Comma-separated blind-copy recipients for EVERY outgoing email (school + developer monitoring)
EMAIL_BCC="ishayadan5@gmail.com,onyevid@gmail.com"

# ---- CBT Exam Resilience ----
# Shared encryption key for exam backup files (AES-256-GCM via PBKDF2)
# Must be the same value as NEXT_PUBLIC_CBT_ENCRYPTION_KEY in the student portal
CBT_ENCRYPTION_KEY=""
